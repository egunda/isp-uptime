# ISP Downtime & Reliability Monitor
# Apache Configuration & Access Rules

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive internal files and directories
    RewriteRule ^server/(data|config\.php|ws_server\.php) - [F,L]
    RewriteRule ^(\.git|client) - [F,L]
    RewriteRule ^(start|stop|install)\.sh$ - [F,L]

    # Map asset requests to server/web if not using symlinks
    RewriteRule ^css/(.*)$ server/web/css/$1 [L]
    RewriteRule ^js/(.*)$ server/web/js/$1 [L]
</IfModule>

# Protect dotfiles and sensitive extensions
<FilesMatch "^\.|\.(json|csv|log|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
