[Unit]
Description=ISP Monitor Self-Recovering Client Daemon
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__PYTHON__ __DIR__/client.py
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=10
LimitNOFILE=65536

# Reduce OOM killer priority so the daemon survives low-memory conditions on Raspberry Pi
OOMScoreAdjust=-500

# Direct daemon stdout and stderr to the rotating client.log
StandardOutput=append:__DIR__/client.log
StandardError=append:__DIR__/client.log

[Install]
WantedBy=multi-user.target
